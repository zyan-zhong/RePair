{
  "$id": "POLICY_CONDITION_MANIFEST_V1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_model_repository": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "base_model_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "chat_template_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "checkpoint_kind": {
      "enum": [
        "BASE_MODEL",
        "LORA_ADAPTER",
        "FULL_CHECKPOINT"
      ],
      "type": "string"
    },
    "checkpoint_path": {
      "maxLength": 4096,
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    },
    "checkpoint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "evaluator_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "memory_version": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "policy_condition_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "type": "string"
    },
    "policy_runtime_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "raw_protocol_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "runtime_core_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "schema_id": {
      "const": "POLICY_CONDITION_MANIFEST_V1",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "served_model_name": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "tokenizer_identity_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "training_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "training_method": {
      "enum": [
        "NONE",
        "SFT"
      ],
      "type": "string"
    },
    "training_run_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "policy_condition_id",
    "base_model_repository",
    "base_model_revision",
    "checkpoint_kind",
    "checkpoint_path",
    "checkpoint_sha256",
    "training_method",
    "training_run_id",
    "training_config_sha256",
    "policy_runtime_manifest_sha256",
    "tokenizer_identity_manifest_sha256",
    "chat_template_sha256",
    "served_model_name",
    "policy_version",
    "memory_version",
    "raw_protocol_sha256",
    "runtime_core_commit",
    "evaluator_commit"
  ],
  "type": "object"
}
