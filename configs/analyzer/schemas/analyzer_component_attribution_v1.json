{
  "$id": "ANALYZER_COMPONENT_ATTRIBUTION_V1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attribution_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence_sha256s": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array"
    },
    "group_result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "principal_component": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "raw_response_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_id": {
      "const": "ANALYZER_COMPONENT_ATTRIBUTION_V1",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "secondary_components": {
