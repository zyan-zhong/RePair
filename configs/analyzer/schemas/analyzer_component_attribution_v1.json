        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "uncertainty": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "validated_result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
