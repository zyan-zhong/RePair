{
  "$id": "ANALYZER_REPAIR_CANDIDATE_V1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "all_intervention_actions_count_against_environment_budget": {
      "const": true,
      "type": "boolean"
    },
    "candidate_kind": {
      "const": "FAILURE_REPAIR",
      "type": "string"
    },
    "candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_status": {
      "enum": [
        "EXECUTABLE_EXACT_ACTION",
        "EXECUTABLE_SHORT_OPTION",
        "ABSTAIN",
        "REJECTED_SOURCE_BINDING",
        "REJECTED_CROSSCHECK"
      ],
      "type": "string"
    },
    "exact_action": {
      "maxLength": 256,
      "type": [
        "string",
        "null"
      ]
    },
    "live_menu_revalidation_required": {
      "const": true,
      "type": "boolean"
    },
    "menu_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "option_actions": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "type": "array"
    },
    "requires_environment_verification": {
      "const": true,
      "type": "boolean"
    },
    "schema_id": {
      "const": "ANALYZER_REPAIR_CANDIDATE_V1",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "source_proposal_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_state_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "termination_condition": {
      "maxLength": 2048,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "candidate_kind",
    "source_state_sha256",
    "menu_sha256",
    "source_proposal_sha256",
    "candidate_status",
    "exact_action",
    "option_actions",
    "termination_condition",
    "requires_environment_verification",
    "candidate_sha256",
    "live_menu_revalidation_required",
    "all_intervention_actions_count_against_environment_budget"
  ],
  "type": "object"
}
