{
  "$id": "ENVIRONMENT_RESULT_PACKAGE_V1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_label_census_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "environment_result_package_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "f0f1_result_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "human_pre_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "protocol_audit_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "round_id": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "schema_id": {
      "const": "ENVIRONMENT_RESULT_PACKAGE_V1",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "training_evidence_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "round_id",
    "human_pre_record_sha256",
    "protocol_audit_sha256",
    "f0f1_result_manifest_sha256",
    "candidate_label_census_sha256",
    "training_evidence_manifest_sha256",
    "environment_result_package_sha256"
  ],
  "type": "object"
}
