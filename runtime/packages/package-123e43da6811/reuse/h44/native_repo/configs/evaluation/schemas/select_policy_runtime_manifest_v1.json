    "manifest_id",
    "server_runtime_manifest_sha256",
    "policy_condition_id",
    "logical_condition_id",
    "checkpoint_instance_id",
    "training_seed",
    "served_model_name",
    "adapter_path",
    "adapter_bundle_sha256",
    "adapter_rank"
