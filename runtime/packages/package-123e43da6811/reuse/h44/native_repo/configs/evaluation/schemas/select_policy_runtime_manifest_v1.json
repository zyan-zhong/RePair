        "string",
        "null"
      ]
    },
    "adapter_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "adapter_rank": {
      "type": [
        "integer",
        "null"
      ]
    },
    "checkpoint_instance_id": {
      "minLength": 1,
      "type": "string"
    },
    "logical_condition_id": {
