{
  "$id": "FORMAL_ANALYZER_DAG_REGISTRY_V2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "FORMAL_ANALYZER_DAG_REGISTRY_V2"
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "round_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "registered_universe_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registered_local_unit_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "local_condition_rows": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_unit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "condition_id": {
            "type": "string",
            "enum": [
              "A0",
              "A1"
            ]
          },
          "common_evidence_pack_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "a1_local_result_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "memory_pack_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate_budget": {
            "type": "integer",
            "const": 1
          },
          "abstain_permitted": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "source_unit_id",
          "condition_id",
          "common_evidence_pack_sha256",
          "a1_local_result_sha256",
          "memory_pack_sha256",
          "candidate_budget",
          "abstain_permitted"
        ]
      }
    },
    "registered_group_manifest_sha256s": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "group_condition_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "group_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "group_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "condition_id": {
            "type": "string",
            "enum": [
              "A2",
              "A3"
            ]
          },
          "member_bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_unit_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "a1_local_result_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "error_instance_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "source_unit_id",
                "a1_local_result_sha256",
                "error_instance_id"
              ]
            }
          },
          "a1_local_result_sha256s": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "current_evidence_sha256s": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "memory_pack_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate_budget": {
            "type": "integer",
            "const": 1
          },
          "abstain_permitted": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "group_id",
          "group_manifest_sha256",
          "condition_id",
          "member_bindings",
          "a1_local_result_sha256s",
          "current_evidence_sha256s",
          "memory_pack_sha256",
          "candidate_budget",
          "abstain_permitted"
        ]
      }
    },
    "local_runtime_input_registry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "group_runtime_input_registry_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "formal_dag_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "round_id",
    "registered_universe_sha256",
    "registered_local_unit_ids",
    "local_condition_rows",
    "registered_group_manifest_sha256s",
    "group_condition_rows",
    "local_runtime_input_registry_sha256",
    "group_runtime_input_registry_sha256",
    "formal_dag_sha256"
  ]
}
